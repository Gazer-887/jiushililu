{
  "name": "jiushililu",
  "version": "0.13.8",
  "description": "九十里路 —— 一个会自己长经验的全能 AI 工作台",
  "main": "out/main/index.js",
  "author": "Gazer",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev --config config/electron.vite.config.ts",
    "build": "electron-vite build --config config/electron.vite.config.ts",
    "start": "electron-vite preview --config config/electron.vite.config.ts",
    "dist": "npm run build && electron-builder --win --config config/electron-builder.yml",
    "typecheck": "tsc --noEmit -p config/tsconfig.main.json && tsc --noEmit -p config/tsconfig.renderer.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --config config/eslint.config.js",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "bench": "vitest run --config config/vitest.bench.config.ts"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.9.1",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.6.0",
    "vite": "^5.4.6",
    "vitest": "^2.1.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  }
}
