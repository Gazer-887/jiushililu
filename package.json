{
  "name": "jiushililu",
  "version": "0.13.83",
  "description": "九十里路 —— 一个会自己长经验的全能 AI 工作台",
  "main": "out/main/index.js",
  "author": "Gazer",
  "license": "MIT",
  "private": true,
  "scripts": {
    "clean:vite-temp": "node scripts/clean-vite-temp.cjs",
    "dev": "npm run clean:vite-temp && electron-vite dev --config config/electron.vite.config.ts",
    "build": "npm run clean:vite-temp && electron-vite build --config config/electron.vite.config.ts",
    "start": "npm run clean:vite-temp && electron-vite preview --config config/electron.vite.config.ts",
    "check:docs": "node scripts/check-docs-fresh.cjs",
    "dist": "npm run check:docs && npm run vendor:ripgrep && npm run build && electron-builder --win --config config/electron-builder.yml && node scripts/verify-dist-rg.cjs",
    "vendor:ripgrep": "node scripts/vendor-ripgrep.cjs",
    "typecheck": "tsc --noEmit -p config/tsconfig.main.json && tsc --noEmit -p config/tsconfig.renderer.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --config config/eslint.config.js",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "test:e2e:xvfb": "xvfb-run --auto-servernum playwright test --config config/playwright.config.ts",
    "bench": "vitest run --config config/vitest.bench.config.ts",
    "bench:window": "node scripts/bench-tool-window.cjs",
    "evals": "node scripts/run-evals.cjs",
    "probe:system": "electron scripts/probe-main-system.cjs",
    "bench:all": "node scripts/bench-all.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "electron-store": "^8.2.0",
    "i18next": "^23.16.8",
    "mammoth": "^1.12.3",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "react-i18next": "^13.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vscode/ripgrep": "^1.18.0",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.9.1",
    "jszip": "^3.10.2",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.6.0",
    "vite": "^5.4.6",
    "vitest": "^2.1.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  }
}
